# Large dataset files (preserve dirs with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE files
.vscode/
.idea/
*.swp
